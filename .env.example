# MongoDB (leads, site content, admin users)
#
# Copy the connection string from Atlas → Database Access → Copy Connection String.
# Production should use Atlas. Local MongoDB is supported for development.
#
#   mongodb+srv://<username>:<password>@<cluster-host>/<database>
#
# The database name at the end of the path is NOT optional. Without it the driver
# falls back to `authSource: admin`, and if your Atlas user was created in another
# database every command fails with:
#
#     MongoServerError: command find requires authentication   (code: 13)
#
# `client.connect()` still succeeds in that case — only the socket opens, the
# authentication happens per command — so the app appears healthy and quietly
# falls back to data/hrms.json for every read. The site then serves stale content
# with no visible error. If you see "DATABASE CONFIGURED BUT NOT USABLE" at boot,
# check this first: the path, then the password.
#
# The string Atlas gives you is ALREADY percent-encoded — a password containing
# "@" arrives as "Ashish%40…". Copy it verbatim. Do NOT run it through an encoder:
# re-encoding turns %40 into %2540 and yields a wrong password. If you ever hand-
# build a URI, only encode a literal reserved character (@ → %40, # → %23),
# never a "%" that is already part of an escape sequence.
#
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/skora
MONGODB_DB=skora

# Set to 1 to boot even when the database is configured but unreachable. Leave
# unset in production: it is the difference between a failed deploy and a site
# quietly serving stale data.
MONGODB_ALLOW_FALLBACK=0

# Next server. The npm scripts load .env before starting Next because Next
# cannot read PORT from .env by itself.
PORT=3001

# Public site URL and host config
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_ALLOWED_IMAGE_HOSTS=images.unsplash.com,example.com
NEXT_PUBLIC_LEGACY_HOSTS=old.example.com,www.old.example.com
NEXT_PUBLIC_REDIRECT_WWW=true
NEXT_ALLOWED_DEV_ORIGINS=

# Site contact values used as the default fallback in the app
NEXT_PUBLIC_SITE_CONTACT_PHONE=
NEXT_PUBLIC_SITE_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_CONTACT_ADDRESS=
NEXT_PUBLIC_SITE_RESPONSE_GUARANTEE=

# Default SEO values (admin-managed values can override these)
NEXT_PUBLIC_SITE_NAME=SKORA
NEXT_PUBLIC_SEO_TITLE_TEMPLATE=%s | SKORA — Digital Marketing & Tech Solutions
NEXT_PUBLIC_SEO_DEFAULT_TITLE=SKORA — Next-Gen Digital Marketing & Tech Solutions Enterprise
NEXT_PUBLIC_SEO_DEFAULT_DESCRIPTION=
NEXT_PUBLIC_SEO_DEFAULT_KEYWORDS=
NEXT_PUBLIC_SEO_OG_IMAGE=
NEXT_PUBLIC_SEO_TWITTER_HANDLE=
NEXT_PUBLIC_SEO_ROBOTS_ENABLED=true
NEXT_PUBLIC_SEO_ROBOTS_DISALLOW=/admin,/api
NEXT_PUBLIC_SEO_SITEMAP_ENABLED=true
NEXT_PUBLIC_ANALYTICS_ID=

# Comma-separated accounts that receive the Super Admin role
SUPER_ADMIN_EMAILS=

# Admin account for /admin/login — filled in locally, applied by `npm run db:seed-admin`.
# Never put real credentials in this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
