# MongoDB (leads, site content, admin users)
# Atlas:      mongodb+srv://<username>:<password>@<cluster>/<database>
# Local dev:  mongodb://127.0.0.1:27017  (start it with ./scripts/local-mongo.sh start)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=skora

# Public site URL
NEXT_PUBLIC_SITE_URL=https://example.com

# Admin account for /admin/login — filled in locally, applied by `npm run db:seed-admin`.
# Never put real credentials in this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
