# SKORA DIGITAL — ENVIRONMENT TEMPLATE (EXAMPLE)
# Copy this file to .env.local and fill in your actual production credentials.

# Admin Portal Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# MongoDB Atlas Cloud Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skora_db?retryWrites=true&w=majority

# Session Encryption Secret Token
JWT_SECRET=your_jwt_secret_token_here

# Hostinger Domain Production Base URL
NEXT_PUBLIC_SITE_URL=https://skora.info

# Transactional email for password-reset delivery (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=HRMS <noreply@yourcompany.com>
