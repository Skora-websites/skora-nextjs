{
  "name": "skora-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint",
    "db:check": "node scripts/db-check.mjs",
    "db:setup-local": "node scripts/setup-local-mongodb.mjs",
    "db:start": "systemctl --user start skora-mongodb.service",
    "db:stop": "systemctl --user stop skora-mongodb.service",
    "db:status": "systemctl --user status skora-mongodb.service --no-pager",
    "db:seed-admin": "node scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@next/env": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.5.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
